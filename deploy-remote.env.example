# 复制为 deploy-remote.env 后再 source：
#   cp deploy-remote.env.example deploy-remote.env
#   source ./deploy-remote.env
#   ./scripts/deploy-remote.sh

# SSH 目标
export DEPLOY_HOST="your.server.ip"
export DEPLOY_USER="root"
export DEPLOY_PORT="22"
export SSH_PASSWORD=""

# 远程部署目录与服务信息
export DEPLOY_PATH="/opt/company-meal-order"
export APP_USER="mealorder"
export SERVICE_NAME="company-meal-order"
export APP_PORT="3000"

# 运行环境
export NODE_MAJOR="22"
export PNPM_VERSION="10.29.3"

# 首次部署必填；后续不填则沿用远程 .env 里的值
export SESSION_PASSWORD="replace-with-a-random-string-at-least-32-chars"
export LOGIN_PASSWORD="replace-with-shared-login-password"
export ADMIN_PASSWORD="replace-with-your-admin-password"

# Nginx / 域名 / HTTPS
export INSTALL_NGINX="1"
export APP_DOMAINS="example.com www.example.com"
export ENABLE_HTTPS="1"
export CERTBOT_EMAIL=""

# HTTPS 时建议 true；留空则脚本会自动根据 ENABLE_HTTPS 推断
export COOKIE_SECURE=""

# 首次部署自动执行种子数据；如果不想要示例数据可以改成 0
export SEED_ON_FIRST_DEPLOY="1"
