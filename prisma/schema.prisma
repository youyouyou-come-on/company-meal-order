generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  createdAt DateTime     @default(now())
  signups   MealSignup[]
}

model WeeklyMenu {
  id       Int      @id @default(autoincrement())
  date     DateTime
  mealType String   // "lunch" or "dinner"
  dishes   String   // 菜品描述

  @@unique([date, mealType])
}

model MealSignup {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime
  mealType  String   // "lunch" or "dinner"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date, mealType])
}
