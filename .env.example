# 数据库文件路径
DATABASE_URL="file:./prod.db"

# Session 加密密钥（请替换为随机 32 位字符串）
SESSION_PASSWORD="替换为随机32位字符串_至少32个字符"

# 员工登录统一密码
LOGIN_PASSWORD="替换为员工登录公共密码"

# 同一 IP 连续登录错误多少次后锁定
LOGIN_LOCK_MAX_FAILED_ATTEMPTS="100"

# 锁定时长（分钟）
LOGIN_LOCK_DURATION_MINUTES="15"

# 管理员密码（进入菜单管理页面需要输入）
ADMIN_PASSWORD="替换为管理员密码"
